{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "spot",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraft:item/map_location_spot"
        }
      },
      {
        "when": "area",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraft:item/map_location_area"
        }
      },
      {
        "when": "path",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraft:item/map_location_path"
        }
      },
      {
        "when": "path_repeating",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraft:item/map_location_path_repeating"
        }
      },
      {
        "when": "zone",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraft:item/map_location_zone"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "buildcraft:item/map_location_clean"
    }
  }
}
